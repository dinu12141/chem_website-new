    "serve:frontend": "cd frontend && yarn serve",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "deploy": "./deploy.sh start",
    "logs": "./deploy.sh logs",
    "status": "./deploy.sh status"
  },
  "keywords": [
    "education",
    "chemistry",
    "sri-lanka",
