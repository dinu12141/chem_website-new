{
  "name": "smartchem-platform",
  "version": "1.0.0",
  "description": "SMARTCHEM Educational Platform - නදීක වර්ණකුල Chemistry Learning Platform",
  "main": "index.js",
  "scripts": {
    "install:all": "cd frontend && yarn install",
    "start:frontend": "cd frontend && yarn start",
    "start:backend": "cd backend && python3 server.py",
